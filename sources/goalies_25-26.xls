<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr class="over_header"> <th aria-label=" " data-stat="header_empty_0" colspan="5" class=" poptip over_header center"></th> <th aria-label="Goalie Stats" data-stat="header_goalie" colspan="19" class=" poptip over_header center">Goalie Stats</th> <th aria-label="Scoring" data-stat="header_scoring" colspan="3" class=" poptip over_header center">Scoring</th> <th aria-label=" " data-stat="header_empty_3" colspan="2" class=" poptip over_header center"></th> </tr> <tr> <th aria-label="Rk" data-stat="ranker" scope="col" class="ranker poptip center" data-tip="Rank">Rk</th> <th aria-label="Player" data-stat="name_display" scope="col" class=" poptip sort_default_asc center">Player</th> <th aria-label="Age" data-stat="age" scope="col" class=" poptip center" data-tip="As of Jan. 31 of the season in question.">Age</th> <th aria-label="Team" data-stat="team_name_abbr" scope="col" class=" poptip sort_default_asc center">Team</th> <th aria-label="Pos" data-stat="pos" scope="col" class=" poptip center" data-tip="Position">Pos</th> <th aria-label="GP" data-stat="goalie_games" scope="col" class=" poptip sort_col center" data-tip="Games Played (Goalie)">GP</th> <th aria-label="GS" data-stat="goalie_starts" scope="col" class=" poptip center" data-tip="Games Started">GS</th> <th aria-label="W" data-stat="goalie_wins" scope="col" class=" poptip center" data-tip="Wins">W</th> <th aria-label="L" data-stat="goalie_losses" scope="col" class=" poptip center" data-tip="Losses">L</th> <th aria-label="T/O" data-stat="goalie_ties" scope="col" class=" poptip center" data-tip="Ties plus OT/SO Losses">T/O</th> <th aria-label="GA" data-stat="goalie_goals_against" scope="col" class=" poptip center" data-tip="Goals Against">GA</th> <th aria-label="Shots" data-stat="shots_against_goalie" scope="col" class=" poptip center" data-tip="Shots Against">Shots</th> <th aria-label="SV" data-stat="goalie_saves" scope="col" class=" poptip center" data-tip="Saves">SV</th> <th aria-label="SV%" data-stat="save_pct_goalie" scope="col" class=" poptip hide_non_quals center" data-tip="Save Percentage" data-filter="1" data-name="">SV%</th> <th aria-label="GAA" data-stat="goals_against_avg" scope="col" class=" poptip hide_non_quals center" data-tip="Goals Against Average" data-filter="1" data-name="">GAA</th> <th aria-label="SO" data-stat="goalie_shutouts" scope="col" class=" poptip center" data-tip="Shutouts">SO</th> <th aria-label="MIN" data-stat="goalie_min" scope="col" class=" poptip center" data-tip="Minutes">MIN</th> <th aria-label="QS" data-stat="quality_starts" scope="col" class=" poptip center" data-tip="Quality Starts&lt;br/&gt;Starts with SV% &gt; average SV% for the year, or at least 88.5% on nights with 20 or fewer shots against.&lt;br/&gt;Developed by Rob Vollman in the Hockey Abstract.">QS</th> <th aria-label="QS%" data-stat="quality_starts_pct" scope="col" class=" poptip center" data-tip="Quality Start Percentage&lt;br/&gt;QS/GS&lt;br/&gt;&gt; 60% Good, &lt; 50% Bad, ~53% League Avg&lt;br/&gt;Developed by Rob Vollman in the Hockey Abstract." data-filter="1" data-name="">QS%</th> <th aria-label="RBS" data-stat="goalie_really_bad_starts" scope="col" class=" poptip center" data-tip="Really Bad Starts&lt;br /&gt;Starts with a SV% below 85%.&lt;br /&gt;Developed by Rob Vollman in the Hockey Abstract">RBS</th> <th aria-label="GA%-" data-stat="ga_pct_minus" scope="col" class=" poptip hide_non_quals center" data-tip="GA Pct- is goals allowed % relative to league goals allowed %&lt;br /&gt;Lower is better, 100 is exactly average, 0 means you have saved 100% of shots faced. Min. appearances in 31.25% of team games needed to qualify (5+ games in the playoffs).">GA%-</th> <th aria-label="GSAA" data-stat="gs_above_avg" scope="col" class=" poptip center" data-tip="Goals Saved Above Average, the goals this goalie prevented given his save percentage and shots faced vs. the league average save percentage on the same number of shots. Min. 4 shots faced per team game needed to qualify." data-filter="1" data-name="">GSAA</th> <th aria-label="GAA/A" data-stat="goals_against_avg_adjusted" scope="col" class=" poptip center" data-tip="Adjusted Goals Against Average" data-filter="1" data-name="">GAA/A</th> <th aria-label="GPS" data-stat="gps" scope="col" class=" poptip center" data-tip="Goalie Point Shares; an estimate of the number of points contributed by a player due to his play in goal." data-filter="1" data-name="">GPS</th> <th aria-label="G" data-stat="goals" scope="col" class=" poptip center" data-tip="Goals">G</th> <th aria-label="A" data-stat="assists" scope="col" class=" poptip center" data-tip="Assists">A</th> <th aria-label="PTS" data-stat="points" scope="col" class=" poptip center" data-tip="Points">PTS</th> <th aria-label="PIM" data-stat="pen_min" scope="col" class=" poptip center" data-tip="Penalties in Minutes">PIM</th> <th aria-label="Awards" data-stat="awards" scope="col" class=" poptip sort_default_asc center">Awards</th> </tr> </thead> <tbody><tr data-row="0"> <th scope="row" class="right " data-stat="ranker" csk="1">1</th> <td class="left " data-append-csv="vejmeka01" data-stat="name_display" csk="Vejmelka Karel-1">Karel Vejmelka</td> <td class="right " data-stat="age">29</td> <td class="left " data-stat="team_name_abbr">UTA</td> <td class="left " data-stat="pos">G</td> <td class="right " data-stat="goalie_games">64</td> <td class="right " data-stat="goalie_starts">63</td> <td class="right " data-stat="goalie_wins">38</td> <td class="right " data-stat="goalie_losses">20</td> <td class="right " data-stat="goalie_ties">3